# Copy values into the process environment; the app deliberately does not auto-load dotenv.
PFM_MODE=demo
PFM_DATABASE=.pfm/pfm.sqlite3
PFM_PORT=8765
PFM_MODEL=openai:gpt-4.1-mini
PFM_MODEL_TIMEOUT=12
# OPENAI_API_KEY=inject-from-secret-manager
PFM_AUDIO_ENABLED=0
# Self-hosted chat:
# PFM_MODEL=openai:your-served-model-id
# PFM_MODEL_BASE_URL=https://models.bank.internal/v1
# PFM_MODEL_API_KEY=inject-from-secret-manager
# Separate speech service:
# PFM_AUDIO_BASE_URL=https://speech.bank.internal/v1
# PFM_AUDIO_API_KEY=inject-from-secret-manager
# Bank identity:
# PFM_JWT_PUBLIC_KEY_FILE=/run/secrets/bank-identity-public.pem
# PFM_JWT_ISSUER=https://identity.bank.example
# PFM_JWT_AUDIENCE=truffles-pfm
# PFM_ALLOWED_HOSTS=pfm.bank.internal
